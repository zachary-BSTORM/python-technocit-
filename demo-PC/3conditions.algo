# Conditions
a = 5
b = 10

// exemple si seul
si a < b alors
		print('message si vrai')
	finsi

// exemple si sinon avec un seul sinon
si a < v alors
		print('message si vrai')
	sinon
		print('message si faux')
	finsi


// exemple Si SinonSi sinon : autant de sinonsi qur nécéssaire un seul sinon
si a < b alors
		print('message si vrai')
	sinonsi a > b alors
		print('message si condition 2 vrai')
    sinonsi a == b alors
		print('message si condition 3 vrai')
	sinon
		print("message si aucune condition au dessus n'est vrai")
	finsi